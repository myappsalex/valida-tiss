generator client {
  provider = "prisma-client-py"
  interface = "sync"
}

datasource db {
  provider = "postgresql"
  url      = env("VALIDA_TISS_DATABASE_POSTGRES_URL")
}

model Cliente {
  id            String         @id @default(uuid())
  nomeEmpresa   String
  emailAcesso   String         @unique
  senhaHash     String
  tokensIA      Int            @default(0)
  statusConta   String         @default("PENDENTE")
  criadoEm      DateTime       @default(now())

  plano                 String                 @default("FREEMIUM")
  qtdPrestadoresUsados  Int                    @default(0)
  prestadoresVinculados PrestadorVinculado[]
  mensalidades          Mensalidade[]
  statusPagamento   String    @default("ATIVO")
  planoValidoAte    DateTime?
  tokenVersion      Int       @default(0)
  tentativasFalhas  Int       @default(0)
  bloqueadoAte      DateTime?
  ultimoLoginEm     DateTime?
  mustChangePassword Boolean  @default(false)
  aceiteTermosEm    DateTime?
  ipAceite          String?
  dataCancelamento  DateTime?
  exportacoesGratis Int       @default(3)
  cpfCnpj           String?
  telefone          String?   // NOVO: Telefone obrigatório para a AbacatePay
  asaasCustomerId   String?

  logsIA        LogIA[]
  campanhaads   CampanhaAds[]
  compras       CompraTokens[]
  regras        RegraCliente[]
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  perfil    String
  criadoEm  DateTime @default(now())
  status             String    @default("ATIVO")
  mustChangePassword Boolean   @default(false)
  tokenVersion       Int       @default(0)
  tentativasFalhas   Int       @default(0)
  bloqueadoAte       DateTime?
  ultimoLoginEm      DateTime?
}

model LogIA {
  id            String   @id @default(uuid())
  clienteId     String
  numeroGuia    String
  motorUsado    String
  tokensGastos  Int      @default(1)
  dataUso       DateTime @default(now())
  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  @@index([clienteId, dataUso])
}

model RegraCliente {
  id            String   @id @default(uuid())
  clienteId     String
  nomeRegra     String
  tipoGuia      String
  campoValidado String
  condicao      String
  valorEsperado String
  acao          String
  mensagemErro  String
  status        String   @default("ATIVO")
  criadoEm      DateTime @default(now())
  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  @@index([clienteId, criadoEm])
}

model DominioTUSS {
  id                 String    @id @default(uuid())
  codigoTabela       String
  codigoTermo        String
  termo              String
  registroAnvisa     String?
  vigenciaInicio     DateTime?
  vigenciaFim        DateTime?
  ativo              Boolean   @default(true)
  fabricante         String?
  apresentacaoModelo String?
  classeRisco        String?
  @@index([codigoTabela, codigoTermo])
}

model TabelaGlosasANS {
  codigoGlosa     String   @id
  descricao       String
  tipo            String
}

model HistoricoAutorizacoes {
  id              String   @id @default(uuid())
  senha           String   @unique
  carteiraBen     String
  dataValidade    DateTime
  status          String
  prestadorId     String
}

model CampanhaAds {
  id              String    @id @default(cuid())
  usuarioId       String
  empresa_nome    String
  email_contato   String
  link_destino    String
  tema            String
  bannerUrl       String?
  valorOrcamento  Float?
  observacaoAdmin String?
  status          String    @default("PENDENTE")
  criadoEm        DateTime  @default(now())
  dataInicio      DateTime?
  dataFim         DateTime?
  localExibicao   String?   @default("CABECALHO")
  bannerMime      String?
  bannerDados     String?
  asaasPaymentId  String?   @unique
  pagoEm          DateTime?
  cliente         Cliente   @relation(fields: [usuarioId], references: [id])
  @@index([usuarioId, status])
  @@index([status, dataInicio, dataFim])
}

model PagamentoProcessado {
  id         String   @id
  referencia String
  valor      Float
  criadoEm   DateTime @default(now())
}

model LogAdmin {
  id        String   @id @default(uuid())
  atorTipo  String
  atorId    String
  atorEmail String
  acao      String
  alvoTipo  String
  alvoId    String
  detalhes  String
  ip        String
  criadoEm  DateTime @default(now())
  @@index([criadoEm])
  @@index([alvoTipo, alvoId])
}

model CompraTokens {
  id              String    @id @default(cuid())
  clienteId       String
  quantidade      Int
  valor           Float
  status          String    @default("AGUARDANDO")
  asaasPaymentId  String?   @unique
  criadoEm        DateTime  @default(now())
  pagoEm          DateTime?
  cliente         Cliente   @relation(fields: [clienteId], references: [id])
  @@index([clienteId, status])
}

model Configuracao {
  chave          String   @id
  valor          String
  anterior       String?
  atualizadoPor  String?
  atualizadoEm   DateTime @default(now()) @updatedAt
}

model PrestadorVinculado {
  id           String   @id @default(uuid())
  clienteId    String
  codigo       String
  criadoEm     DateTime @default(now())
  planoRef     String
  cliente      Cliente  @relation(fields: [clienteId], references: [id])
  @@unique([clienteId, codigo])
  @@index([clienteId])
}

model Mensalidade {
  id            String    @id @default(uuid())
  clienteId     String
  mesRef        String
  vencimento    DateTime
  dataPagamento DateTime?
  valorBase     Float
  status        String    @default("EM ABERTO")
  criadoEm      DateTime  @default(now())
  cliente       Cliente   @relation(fields: [clienteId], references: [id])
  @@index([clienteId, status])
}

model ConfiguracaoPlano {
  id             String   @id @default(uuid())
  nome           String
  valor          Float
  limite         Int
  vigenciaInicio DateTime @default(now())
  @@index([nome, vigenciaInicio])
}