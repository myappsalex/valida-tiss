generator client {
  provider             = "prisma-client-py"
  interface            = "sync" // Para facilitar o uso com o BaseHTTPRequestHandler da Vercel
}

datasource db {
  provider = "postgresql"
  url      = env("VALIDA_TISS_DATABASE_POSTGRES_URL")
}

// Motor de Regras Customizáveis por Cliente
model RegraCliente {
  id            String   @id @default(uuid())
  clienteId     String
  nomeRegra     String   // Ex: "Alerta de OPME Caro"
  tipoGuia      String   // "TODAS", "guiaConsulta", "guiaSP-SADT"
  campoValidado String   // "codigoProcedimento", "valorTotalGeral", "codigoTabela"
  condicao      String   // "IGUAL", "CONTEM", "MAIOR_QUE", "MENOR_QUE"
  valorEsperado String   // Ex: "5000.00"
  acao          String   // "ALERTA" ou "BLOQUEIO"
  mensagemErro  String   // Ex: "Guia retida: Valor de OPME superior ao teto contratual."
  status        String   @default("ATIVO") // ATIVO, INATIVO
  criadoEm      DateTime @default(now())

  cliente       Cliente  @relation(fields: [clienteId], references: [id])
}

// Registo de auditorias (Para o extrato do cliente e controlo de custos)
model LogIA {
  id            String   @id @default(uuid())
  clienteId     String
  numeroGuia    String
  motorUsado    String   // gemini, chatgpt, deepseek
  tokensGastos  Int      @default(1)
  dataUso       DateTime @default(now())

  cliente       Cliente  @relation(fields: [clienteId], references: [id])
}

// Gestão dos Banners de Publicidade
model Campanha {
  id            String   @id @default(uuid())
  clienteId     String
  localBanner   String   // CABECALHO, RODAPE
  status        String   @default("ANALISE") // ANALISE, ATIVO, CONCLUIDO
  urlDestino    String?
  dataInicio    DateTime?
  dataFim       DateTime?

  cliente       Cliente  @relation(fields: [clienteId], references: [id])
}

model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  perfil    String   
  criadoEm  DateTime @default(now())
}

// Motor de Regras Customizáveis por Cliente
model RegraCliente {
  id            String   @id @default(uuid())
  clienteId     String
  nomeRegra     String   // Ex: "Alerta de OPME Caro"
  tipoGuia      String   // "TODAS", "guiaConsulta", "guiaSP-SADT"
  campoValidado String   // "codigoProcedimento", "valorTotalGeral", "codigoTabela"
  condicao      String   // "IGUAL", "CONTEM", "MAIOR_QUE", "MENOR_QUE"
  valorEsperado String   // Ex: "5000.00"
  acao          String   // "ALERTA" ou "BLOQUEIO"
  mensagemErro  String   // Ex: "Guia retida: Valor de OPME superior ao teto contratual."
  status        String   @default("ATIVO") // ATIVO, INATIVO
  criadoEm      DateTime @default(now())

  cliente       Cliente  @relation(fields: [clienteId], references: [id])
}