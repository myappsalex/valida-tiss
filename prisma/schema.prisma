generator client {
  provider             = "prisma-client-py"
  interface            = "sync" // Para facilitar o uso com o BaseHTTPRequestHandler da Vercel
}

datasource db {
  provider = "postgresql"
  url      = env("VALIDA_TISS_DATABASE_POSTGRES_URL")
}

// Tabela 1: Clientes Externos (SaaS)
model Cliente {
  id            String         @id @default(uuid())
  nomeEmpresa   String
  emailAcesso   String         @unique
  senhaHash     String
  tokensIA      Int            @default(0)
  statusConta   String         @default("PENDENTE") 
  criadoEm      DateTime       @default(now())

  // Relacionamentos (O que o cliente "possui")
  logsIA        LogIA[]
  campanhas     Campanha[]
  regras        RegraCliente[]
}

// Tabela 2: Utilizadores Internos (Admin/Backoffice)
model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  perfil    String   
  criadoEm  DateTime @default(now())
}

// Tabela 3: Registo de auditorias (Controlo de custos)
model LogIA {
  id            String   @id @default(uuid())
  clienteId     String
  numeroGuia    String
  motorUsado    String   
  tokensGastos  Int      @default(1)
  dataUso       DateTime @default(now())

  cliente       Cliente  @relation(fields: [clienteId], references: [id])
}

// Tabela 4: Gestão dos Banners de Publicidade
model Campanha {
  id            String   @id @default(uuid())
  clienteId     String
  localBanner   String   
  status        String   @default("ANALISE") 
  urlDestino    String?
  dataInicio    DateTime?
  dataFim       DateTime?
  
  cliente       Cliente  @relation(fields: [clienteId], references: [id])
}

// Tabela 5: Motor de Regras Customizáveis por Cliente
model RegraCliente {
  id            String   @id @default(uuid())
  clienteId     String
  nomeRegra     String   
  tipoGuia      String   
  campoValidado String   
  condicao      String   
  valorEsperado String   
  acao          String   
  mensagemErro  String   
  status        String   @default("ATIVO") 
  criadoEm      DateTime @default(now())

  cliente       Cliente  @relation(fields: [clienteId], references: [id])
}