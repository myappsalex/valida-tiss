// schema.prisma MESCLADO: o seu schema original + colunas/tabelas exigidas pelo código novo.
// Tudo marcado com "// NOVO" é acréscimo; nada do que existia foi removido ou renomeado.
generator client {
  provider = "prisma-client-py"
  interface = "sync" // Para facilitar o uso com o BaseHTTPRequestHandler da Vercel
}

datasource db {
  provider = "postgresql"
  url      = env("VALIDA_TISS_DATABASE_POSTGRES_URL")   // use a URL do POOLER (pgbouncer=true&connection_limit=1)
}

// Tabela 1: Clientes Externos (SaaS)
model Cliente {
  id            String         @id @default(uuid())
  nomeEmpresa   String
  emailAcesso   String         @unique
  senhaHash     String
  tokensIA      Int            @default(0)
  statusConta   String         @default("PENDENTE")
  criadoEm      DateTime       @default(now())

  // NOVO – assinatura (antes não existia em nenhum modelo; o admin lia/gravava campos inexistentes)
  plano             String    @default("FREEMIUM")   // FREEMIUM | PREMIUM
  statusPagamento   String    @default("ATIVO")      // ATIVO | INATIVO
  planoValidoAte    DateTime?
  // NOVO – segurança de sessão e conta
  tokenVersion      Int       @default(0)            // incrementa => revoga sessões
  tentativasFalhas  Int       @default(0)
  bloqueadoAte      DateTime?
  ultimoLoginEm     DateTime?
  mustChangePassword Boolean  @default(false)
  aceiteTermosEm    DateTime?                         // LGPD
  dataCancelamento  DateTime?
  exportacoesGratis Int       @default(3)            // NOVO – degustação FREEMIUM controlada no servidor (antes: sessionStorage, burlável)
  // NOVO – cobrança Asaas
  cpfCnpj           String?
  asaasCustomerId   String?

  // Relacionamentos (O que o cliente "possui")
  logsIA        LogIA[]
  campanhaads     CampanhaAds[]
  compras         CompraTokens[]
  regras        RegraCliente[]
}

// Tabela 2: Utilizadores Internos (Admin/Backoffice)
model Usuario {
  id        String   @id @default(uuid())
  nome      String
  email     String   @unique
  senhaHash String
  perfil    String                                   // ADMIN | OPERACAO | PUBLICIDADE | GESTAO
  criadoEm  DateTime @default(now())

  // NOVO
  status             String    @default("ATIVO")     // ATIVO | BLOQUEADO | CANCELADO (antes o bloqueio sobrescrevia `perfil`)
  mustChangePassword Boolean   @default(false)
  tokenVersion       Int       @default(0)
  tentativasFalhas   Int       @default(0)
  bloqueadoAte       DateTime?
  ultimoLoginEm      DateTime?
}

// Tabela 3: Registo de auditorias (Controlo de custos)
model LogIA {
  id            String   @id @default(uuid())
  clienteId     String
  numeroGuia    String
  motorUsado    String
  tokensGastos  Int      @default(1)
  dataUso       DateTime @default(now())

  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  @@index([clienteId, dataUso])                     // NOVO
}

// Tabela 5: Motor de Regras Customizáveis por Cliente
model RegraCliente {
  id            String   @id @default(uuid())
  clienteId     String
  nomeRegra     String
  tipoGuia      String
  campoValidado String
  condicao      String
  valorEsperado String
  acao          String
  mensagemErro  String
  status        String   @default("ATIVO")
  criadoEm      DateTime @default(now())

  cliente       Cliente  @relation(fields: [clienteId], references: [id])
  @@index([clienteId, criadoEm])                    // NOVO
}

// --- TABELAS DE DOMÍNIO TUSS E GLOSAS (Versão 2.0.0) ---

model DominioTUSS {
  id                 String    @id @default(uuid())
  codigoTabela       String
  codigoTermo        String
  termo              String
  registroAnvisa     String?
  vigenciaInicio     DateTime?
  vigenciaFim        DateTime?
  ativo              Boolean   @default(true)

  // --- NOVOS CAMPOS PARA TABELAS 19 E 20 ---
  fabricante         String?
  apresentacaoModelo String?
  classeRisco        String?

  @@index([codigoTabela, codigoTermo])
}

model TabelaGlosasANS {
  codigoGlosa     String   @id // Ex: 1001, 1102, 1203, 1311
  descricao       String   // Ex: Código incompatível com a tabela
  tipo            String   // Administrativa, Técnica, etc.
}

model HistoricoAutorizacoes {
  id              String   @id @default(uuid())
  senha           String   @unique
  carteiraBen     String
  dataValidade    DateTime
  status          String   // APROVADA, NEGADA, PARCIAL
  prestadorId     String
}

model CampanhaAds {
  id              String    @id @default(cuid())
  usuarioId       String                                   // = Cliente.id (nome mantido por compatibilidade)
  empresa_nome    String
  email_contato   String
  link_destino    String
  tema            String
  bannerUrl       String?
  valorOrcamento  Float?
  observacaoAdmin String?
  status          String    @default("PENDENTE")           // PENDENTE|ORCADO|AGUARDANDO_PAGAMENTO|ATIVO|CANCELADO|REJEITADO|EXPIRADO
  criadoEm        DateTime  @default(now())
  dataInicio      DateTime?
  dataFim         DateTime?
  localExibicao   String?   @default("CABECALHO")

  // NOVO
  bannerMime      String?
  bannerDados     String?                                  // PNG/JPEG em base64 (validado, máx. 300 KB)
  asaasPaymentId  String?   @unique
  pagoEm          DateTime?

  cliente         Cliente   @relation(fields: [usuarioId], references: [id])
  @@index([usuarioId, status])                             // NOVO
  @@index([status, dataInicio, dataFim])                   // NOVO
}

// NOVO – idempotência do webhook do Asaas (PK = id da cobrança)
model PagamentoProcessado {
  id         String   @id
  referencia String
  valor      Float
  criadoEm   DateTime @default(now())
}

// NOVO – trilha de auditoria das ações administrativas (sem senhas)
model LogAdmin {
  id        String   @id @default(uuid())
  atorTipo  String
  atorId    String
  atorEmail String
  acao      String
  alvoTipo  String
  alvoId    String
  detalhes  String
  ip        String
  criadoEm  DateTime @default(now())
  @@index([criadoEm])
  @@index([alvoTipo, alvoId])
}

// NOVO – compra de pacotes de tokens de IA via PIX (o valor é calculado no servidor)
model CompraTokens {
  id              String    @id @default(cuid())
  clienteId       String
  quantidade      Int
  valor           Float
  status          String    @default("AGUARDANDO")      // AGUARDANDO | PAGO | CANCELADO
  asaasPaymentId  String?   @unique
  criadoEm        DateTime  @default(now())
  pagoEm          DateTime?

  cliente         Cliente   @relation(fields: [clienteId], references: [id])
  @@index([clienteId, status])
}

model Configuracao {
  chave          String   @id
  valor          String
  anterior       String?
  atualizadoPor  String?
  atualizadoEm   DateTime @default(now()) @updatedAt
}
